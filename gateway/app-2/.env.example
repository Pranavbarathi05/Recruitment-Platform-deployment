[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# App 2 — Environment Variables   (SYSTEM 4)
#
# Copy this file to .env ON THE APP-2 MACHINE and fill in the values.
# DO NOT commit .env to version control.
#
# This file is INDEPENDENT of gateway/app-1/.env — do not copy App-1's secrets
# file across. App-2 talks to the SAME Supabase project (one recruitment
# database), but it has its own configuration here.
#
# Sections: LAN configuration / service configuration / secret configuration.
# ══════════════════════════════════════════════════════════════════════════════

# ── LAN configuration ────────────────────────────────────────────────────────

# This machine's LAN address — the one the Gateway uses to reach it.
# Find it with:  hostname -I | awk '{print $1}'      (Linux)
#                ipconfig                            (Windows)
# It is pasted into the GATEWAY machine's .env as APP2_URL / APP2_CHALLENGE_URL
# (http://<APP2_LAN_IP>:8002 and http://<APP2_LAN_IP>:8080).
# Optional here: used only if you bind the published ports to one interface.
#APP2_LAN_IP=192.168.1.24

# Host port for the App-2 API. The Gateway reaches App-2 at
# http://<APP2_LAN_IP>:APP2_HOST_PORT . Default 8002 (same number as App-1 is
# fine — it is a different machine; change it if this host already uses 8002).
APP2_HOST_PORT=8002

# Interface the API port is published on. 0.0.0.0 + the DOCKER-USER guard
# (below) is the normal setup; set this to the LAN IP to also stop the API
# listening on any other interface.
#APP2_API_BIND=0.0.0.0

# ── SQLi challenge server (Hands-On "Employee Portal") ──────────────────────
# challenge-2 publishes the challenge container (8080 inside) on this host
# port. The GATEWAY machine's Traefik routes /challenge/* to
# http://<APP2_LAN_IP>:8080 — keep that value equal to APP2_CHALLENGE_PORT.
APP2_CHALLENGE_PORT=8080

# Interface the challenge port is published on.
#APP2_CHALLENGE_BIND=0.0.0.0
#
# FIREWALL (required): candidates must NOT reach the challenge or the API
# directly — they always go through the Gateway (http://<GATEWAY_IP>/).
# NOTE: ufw/INPUT rules do NOT filter Docker-published ports (DNAT → FORWARD
# bypasses INPUT). Restrict them with the shared DOCKER-USER guard:
#   sudo ./docker-port-guard.sh --gateway-ip <GATEWAY_LAN_IP>
# Persist it with a systemd unit — see DEPLOYMENT.md → Firewall.

# ── Service configuration ────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# The SAME Supabase project as App-1 (Project Settings → API). Both backends
# serve one shared recruitment database — do not create a second project.
# The application will NOT start correctly with placeholder values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key (used by the backend to call Supabase Auth server-side)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins (comma-separated). Through the Gateway every browser request
# is same-origin, so this is not exercised in the LAN deployment.
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# ── Compiler pool (Compiler-1 / Compiler-2 / Compiler-3) ────────────────────
# Set EVERY compiler node that exists. The app backend distributes submissions
# round-robin across them and fails over if one is unreachable.
# Use the compiler machines' LAN addresses (port 2358 is the Judge0 API).
# Any subset works; leave them all unset to fall back to JUDGE0_BASE_URL.
#COMPILER_1_URL=http://<COMPILER1_LAN_IP>:2358
#COMPILER_2_URL=http://<COMPILER2_LAN_IP>:2358
#COMPILER_3_URL=http://<COMPILER3_LAN_IP>:2358

# Legacy single-node address — only used when no COMPILER_n_URL is set above.
# Keep the default when a compiler node runs on this same host; otherwise set
# it to that node's LAN address (http://<COMPILER1_LAN_IP>:2358).
JUDGE0_BASE_URL=http://judge0-server:2358

# ── Secret configuration ─────────────────────────────────────────────────────
# Every value here is a secret. They are never baked into images and never
# committed.

# Shared API token for the compiler nodes. MUST equal AUTHN_TOKEN in each
# compiler machine's gateway/judge0/judge0.conf. Generate once and reuse the
# same value on every App and Gateway machine.
JUDGE0_AUTH_TOKEN=your-judge0-authn-token
JUDGE0_AUTH_HEADER=X-Judge0-Token

# NOTE: this file contains Supabase keys and the compiler token. It is covered
# by .gitignore — verify with `git check-ignore -v gateway/app-2/.env`.
