[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# Compiler node (Judge0) — Environment Variables
#
# Copy this file to .env ON EACH EXECUTION MACHINE and adjust the three
# node-identity values. Everything else has a working default.
#
#   Compiler-1 (System 3)   COMPILER_NAME=compiler-1
#   Compiler-2 (System 5)   COMPILER_NAME=compiler-2
#   Compiler-3 (System 6)   COMPILER_NAME=compiler-3
#
# DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── LAN configuration ────────────────────────────────────────────────────────
# This node's identity. Sets the Compose project name and the container names
# (e.g. compiler-2-server, compiler-2-worker, compiler-2-db, compiler-2-redis),
# so Compiler-1/2/3 never collide — even on one host.
# Default `judge0` keeps the original container names (judge0-server, …).
COMPILER_NAME=compiler-1

# Docker network this node's containers share.
# Leave as `system3` on a dedicated machine (create it once:
#   docker network create system3 ).
# When several compiler nodes run on the SAME host, give each node its own
# network name (compiler-1-net, compiler-2-net, …) so their Redis/PostgreSQL
# service names cannot resolve across nodes.
COMPILER_NETWORK=system3

# Host interface the Judge0 API binds to.
#   127.0.0.1  — only this machine can call it.
#   0.0.0.0    — the Gateway and App machines can call it over the LAN.
#                REQUIRED on a dedicated execution machine. Then restrict the
#                port to those machines' IPs with the guard:
#                  sudo ./docker-port-guard.sh --ports 2358 \
#                       --gateway-ip <GATEWAY_LAN_IP> \
#                       --gateway-ip <APP1_LAN_IP> --gateway-ip <APP2_LAN_IP>
JUDGE0_BIND=127.0.0.1

# Host port for the Judge0 API (container port 2358). The App/Gateway machines
# reach this node at http://<COMPILERn_LAN_IP>:<JUDGE0_PORT>.
JUDGE0_PORT=2358

# Path to the node's Judge0 configuration + secrets file (git-ignored).
# Create it once:   cp judge0.conf.example judge0.conf
JUDGE0_CONF_PATH=./judge0.conf

# ── Service configuration (informational) ────────────────────────────────────
# The real service settings — worker count, queue size, resource ceilings,
# cgroup-v2 compatibility flags and the API auth token — live in judge0.conf
# (see judge0.conf.example). PostgreSQL and Redis publish no host ports and use
# the credentials in that same file.

# ── Secret configuration (NOT here) ──────────────────────────────────────────
# judge0.conf holds every secret for this node:
#   AUTHN_TOKEN        shared API token — must equal JUDGE0_AUTH_TOKEN in
#                      gateway/.env and (on the App machines) the token passed
#                      to the app backend
#   REDIS_PASSWORD     Redis password
#   POSTGRES_PASSWORD  PostgreSQL password
#   SECRET_KEY_BASE    Rails secret
# Never put those in this file, and never commit judge0.conf.
