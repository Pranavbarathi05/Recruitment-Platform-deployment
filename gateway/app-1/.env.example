# ══════════════════════════════════════════════════════════════════════════════
# App 1 — Environment Variables
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# The application will NOT start without these values.
# For demo/testing with dummy values, the app starts but DB operations fail.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key (used by the backend to call Supabase Auth server-side)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# ── Network ──────────────────────────────────────────────────────────────────
# Host-side port for App 1.
# For LAN deployment, Gateway reaches App 1 at <APP1_LAN_IP>:APP1_HOST_PORT
APP1_HOST_PORT=8002

# ── Judge0 (C++/Java execution) ─────────────────────────────────────────────
# App 1 joins the external Judge0 network (system3) and calls judge0-server
# directly — same architecture as gateway-api. The token must match
# AUTHN_TOKEN in gateway/judge0/judge0.conf.
# Create the network once:  docker network create system3
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=your-judge0-authn-token
JUDGE0_AUTH_HEADER=X-Judge0-Token
