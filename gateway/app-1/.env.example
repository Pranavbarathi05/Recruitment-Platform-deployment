[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# App 1 — Environment Variables   (SYSTEM 2)
#
# Copy this file to .env ON THE APP-1 MACHINE and adjust as needed.
# DO NOT commit .env to version control.
#
# Sections: LAN configuration / service configuration / secret configuration.
# ══════════════════════════════════════════════════════════════════════════════

# ── LAN configuration ────────────────────────────────────────────────────────

# Host-side port for App 1's API.
# The Gateway reaches App 1 at http://<APP1_LAN_IP>:APP1_HOST_PORT — that value
# goes into the GATEWAY machine's .env as APP1_URL.
APP1_HOST_PORT=8002

# Interface the API port is published on. 0.0.0.0 + the DOCKER-USER guard is
# the normal setup; set this to this machine's LAN IP to also stop it
# listening on any other interface.
#APP1_API_BIND=0.0.0.0

# ── SQLi challenge server (Hands-On "Employee Portal") ──────────────────────
# challenge-1 publishes the challenge container (8080 inside) on this host
# port. The GATEWAY machine's Traefik routes /challenge/* to
# http://<APP1_LAN_IP>:8080 — keep that value equal to APP1_CHALLENGE_PORT.
APP1_CHALLENGE_PORT=8080

# Restrict the published port to specific interfaces by overriding, e.g.
# APP1_CHALLENGE_BIND=<APP1_LAN_IP>. Default listens on all interfaces.
#APP1_CHALLENGE_BIND=0.0.0.0

# FIREWALL (required): candidates must NOT reach the challenge or the API
# directly — they always go through the Gateway (http://<GATEWAY_IP>/).
# NOTE: ufw/INPUT rules do NOT filter Docker-published ports (DNAT → FORWARD
# bypasses INPUT). Restrict them with the shared DOCKER-USER guard:
#   sudo ./docker-port-guard.sh --gateway-ip <GATEWAY_LAN_IP>
# (the same script guards App-2 and the Compiler machines with --ports 2358).
# Persist it with a systemd unit — see DEPLOYMENT.md → Firewall.

# ── Service configuration ───────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# The application will NOT start without these values.
# App-1 and App-2 share ONE Supabase project (one recruitment database).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public anon key (used by the backend to call Supabase Auth server-side)
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_JWT_SECRET=your-jwt-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins (comma-separated). Through the Gateway every browser call is
# same-origin, so CORS is not involved in the LAN deployment.
CORS_ORIGINS=http://localhost:80,http://localhost:5173

# ── Compiler pool (Compiler-1 / Compiler-2 / Compiler-3) ────────────────────
# Set EVERY compiler node that exists. The backend distributes code
# submissions round-robin across them and fails over if one is unreachable.
# Use each compiler machine's LAN address (port 2358 is the Judge0 API).
# Any subset works; leave them all unset to use JUDGE0_BASE_URL alone.
#COMPILER_1_URL=http://<COMPILER1_LAN_IP>:2358
#COMPILER_2_URL=http://<COMPILER2_LAN_IP>:2358
#COMPILER_3_URL=http://<COMPILER3_LAN_IP>:2358

# Legacy single-node address — used only when no COMPILER_n_URL is set above.
# Keep the default when a compiler node runs on THIS machine; otherwise set it
# to that node's LAN address (http://<COMPILER1_LAN_IP>:2358).
JUDGE0_BASE_URL=http://judge0-server:2358

# ── Secret configuration ─────────────────────────────────────────────────────

# Shared API token for the compiler nodes. MUST equal AUTHN_TOKEN in each
# compiler machine's gateway/judge0/judge0.conf (and the value in gateway/.env).
JUDGE0_AUTH_TOKEN=your-judge0-authn-token
JUDGE0_AUTH_HEADER=X-Judge0-Token
