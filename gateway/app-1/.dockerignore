# Docker build context exclusions for App 1
# The build context is gateway/ (parent directory)

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environments
.venv/
venv/

# Environment files (secrets)
.env
.env.local
.env.production

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Documentation
*.md

# Test files (not needed in production image)
tests/
*_test.py
test_*.py
pytest.ini
requirements-integration.txt

# Docker files (don't nest)
docker-compose*.yml
Dockerfile
.dockerignore

# Gateway infrastructure (not needed in App 1 image)
gateway-api/
compiler-1/
compiler_client/
traefik/
test-backend/
recruit-app/

# Freebuff platform metadata
.freebuff/
