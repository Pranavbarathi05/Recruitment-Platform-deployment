# ── Monitoring stack (gateway/monitoring) ────────────────────────────────────
# Copy to .env in this directory to override defaults. LAN/admin only.

# Grafana admin account (change these; never commit real passwords).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Host ports. Grafana is LAN-visible; Prometheus stays loopback-only.
MONITOR_PORT=3001
PROMETHEUS_PORT=9090

# ── Real multi-machine LAN deployment (documentation only) ──────────────────
# When System 2 / System 3 run on separate physical machines, each machine
# runs node-exporter (+ cAdvisor if it hosts Docker). Record their LAN
# addresses here and mirror them into prometheus/systems.yml (file_sd).
SYSTEM1_EXPORTER=<system1-ip>:9100
SYSTEM2_EXPORTER=<system2-ip>:9100
SYSTEM3_EXPORTER=<system3-ip>:9100