[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# Gateway Phase 3 – Environment Variables
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Traefik ──────────────────────────────────
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# ── Gateway API ──────────────────────────────
APP_ENV=development
APP_VERSION=0.8.0
SESSION_TIMEOUT_SECONDS=300
STALE_CHECK_INTERVAL_SECONDS=60

# ── App 1 (External Service) ────────────────
# App 1 is on System 2 (separate physical machine).
# Set this to the LAN IP and port of App 1.
#
# For LAN deployment:
#   APP1_URL=http://<APP1_LAN_IP>:8002
#
# For local testing (same machine):
#   APP1_URL=http://localhost:8002
#
# To find App 1's LAN IP, run on System 2:
#   ip route get 1 | awk '{print $7; exit}'
APP1_URL=http://localhost:8002

# ── Compiler 1 (Code Execution Service) ─────
# Compiler 1 is on a separate machine (System 3).
# Set this to the LAN IP and port of Compiler 1.
#
# For LAN deployment:
#   COMPILER_URL=http://<COMPILER_1_LAN_IP>:8001
#
# For local testing (same machine):
#   COMPILER_URL=http://localhost:8001
#
# For Docker internal network (same compose stack):
#   COMPILER_URL=http://compiler-1:8000
COMPILER_URL=http://compiler-1:8000

# Compiler request timeout in seconds
COMPILER_TIMEOUT=60.0

# ── Supabase (for App 1) ────────────────────
# These are passed to App 1 through its own .env
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret
