[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# Gateway Environment Variables
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Traefik ──────────────────────────────────────────────────────────────────
# HTTP port Traefik listens on (host-side)
TRAEFIK_HTTP_PORT=80

# Traefik dashboard port (host-side, internal only)
TRAEFIK_DASHBOARD_PORT=8080

# ── Application ──────────────────────────────────────────────────────────────
# Environment tag shown in /api/info
APP_ENV=development

# Phase / version tag
APP_VERSION=0.3.0

# ── Session Control ──────────────────────────────────────────────────────────
# Seconds of inactivity before a session is marked inactive
SESSION_TIMEOUT_SECONDS=300

# How often the stale-checker background thread wakes up (seconds)
STALE_CHECK_INTERVAL_SECONDS=60

# ── Compiler 1 ──────────────────────────────────────────────────────────────
# Compiler 1 address (LAN or local)
COMPILER_URL=http://compiler-1:8000

# Request timeout for compiler calls (seconds)
COMPILER_TIMEOUT=60.0

# ── App 1 (External Service) ────────────────────────────────────────────────
# Address of App 1 backend (separate physical machine for LAN deployment)
# For local testing:  http://host.docker.internal:8002
# For LAN deployment: http://<APP1_LAN_IP>:8002
APP1_URL=http://host.docker.internal:8002

# ── SQLi challenge server (Hands-On "Employee Portal") ──────────────────────
# Runs on App-1's machine (challenge-1 container). App-1 publishes the
# challenge on its host port 8080 (APP1_CHALLENGE_PORT in app-1/.env) and
# restricts it to THIS machine with the DOCKER-USER guard
# (app-1/challenge-firewall.sh — ufw/INPUT rules do NOT cover published
# ports). Traefik routes /challenge/* here.
#
# LAN deployment (App-1 is a different physical machine — set its LAN IP):
#   APP1_CHALLENGE_URL=http://<APP1_LAN_IP>:8080
# Same-machine testing:
#   APP1_CHALLENGE_URL=http://host.docker.internal:8080
#
# NEVER point this at this machine's own :8080 — that is the Traefik
# dashboard port, not the challenge.
APP1_CHALLENGE_URL=http://host.docker.internal:8080

# ── Frontend (React SPA) ────────────────────────────────────────────────────
# Supabase credentials for the frontend build (VITE_* prefix for Vite)
# These are the PUBLIC anon key, NOT the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── System 3 (Judge0) ──────────────────────────────────────────────────────
# Execution backend: judge0 (System 3) or compiler1 (legacy)
EXECUTION_BACKEND=judge0
# Judge0 API address (system3 docker network)
JUDGE0_URL=http://judge0-server:2358
# Request timeout for Judge0 calls (seconds)
JUDGE0_TIMEOUT=60.0
# Judge0 API auth token - MUST equal AUTHN_TOKEN in gateway/judge0/judge0.conf
JUDGE0_AUTH_TOKEN=your-judge0-auth-token
JUDGE0_AUTH_HEADER=X-Judge0-Token
