[TEMPLATE]
# ─────────────────────────────────────────────
# Gateway Phase 3 – Environment Variables
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────

# ── Traefik ──────────────────────────────────
# HTTP port Traefik listens on (host-side)
TRAEFIK_HTTP_PORT=80

# Traefik dashboard port (host-side, internal only)
TRAEFIK_DASHBOARD_PORT=8080

# ── Gateway API ──────────────────────────────
# Environment tag shown in /api/info
APP_ENV=development

# Phase / version tag
APP_VERSION=0.3.0

# Seconds of inactivity before a session is marked inactive
SESSION_TIMEOUT_SECONDS=300

# How often the stale-checker background thread wakes up (seconds)
STALE_CHECK_INTERVAL_SECONDS=60

# ── Recruit App (dsc-recruit backend) ────────
# REQUIRED: Supabase configuration.
# The recruit-app will NOT start without these values.
# For demo/testing with dummy values, the app starts but DB operations fail.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS origins for the recruit-app (comma-separated)
RECRUIT_CORS_ORIGINS=http://localhost:80,http://localhost:5173
