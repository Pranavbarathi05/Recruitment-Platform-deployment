# ─────────────────────────────────────────────
# Gateway Phase 2 – Environment Variables
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────

# ── Traefik ──────────────────────────────────
# HTTP port Traefik listens on (host-side)
TRAEFIK_HTTP_PORT=80

# Traefik dashboard port (host-side, internal only)
TRAEFIK_DASHBOARD_PORT=8080

# ── Application ──────────────────────────────
# Environment tag shown in /api/info
APP_ENV=development

# Phase / version tag
APP_VERSION=0.2.0

# ── Dummy Backends ────────────────────────────
# Internal port each dummy backend listens on (inside container)
BACKEND_PORT=8000

# ── Session Control ───────────────────────────
# Seconds of inactivity before a session is marked inactive
SESSION_TIMEOUT_SECONDS=300

# How often the stale-checker background thread wakes up (seconds)
STALE_CHECK_INTERVAL_SECONDS=60
