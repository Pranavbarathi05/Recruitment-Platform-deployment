[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# Gateway Environment Variables   (SYSTEM 1)
#
# Copy this file to .env and adjust as needed.
# DO NOT commit .env to version control.
#
# Sections: LAN configuration / service configuration / secret configuration.
# Only the LAN addresses need editing for a normal deployment — every machine
# not configured here is simply left out of the routing pools.
# ══════════════════════════════════════════════════════════════════════════════

# ── LAN configuration: this machine ─────────────────────────────────────────

# Candidate-facing HTTP port (the front door). Change only if 80 is taken.
TRAEFIK_HTTP_PORT=80

# Traefik dashboard port (operator-only; keep LAN-restricted). This is NOT the
# Hands-On challenge — the challenge is at /challenge/ on the front door.
TRAEFIK_DASHBOARD_PORT=8080

# ── LAN configuration: application backend pool (App-1 + App-2) ─────────────
# Address of each App machine's API. Traefik load-balances /auth/*,
# /questions/*, /submission/*, /assessment/*, /coding/*, /admin/* across every
# machine listed here and stops using one that is unhealthy.
#
# Find an App machine's IP with:  hostname -I | awk '{print $1}'   (Linux)
#                                 ipconfig                          (Windows)
# Then use its API host port (APPn_HOST_PORT in that machine's .env, 8002).
#
# For same-machine testing: http://host.docker.internal:8002
APP1_URL=http://host.docker.internal:8002

# App-2 backend. Leave EMPTY until the App-2 machine exists — an empty value
# keeps App-2 out of the pool. Set it and re-run `docker compose up -d` to
# start using App-2 (no rebuild, no file edits).
APP2_URL=

# ── LAN configuration: Hands-On challenge pool (challenge-1 + challenge-2) ──
# The SQLi "Employee Portal" challenge servers. Traefik routes /challenge/*
# here (prefix stripped) and load-balances across every machine listed.
#
# App-1 publishes its challenge on its host port 8080 (APP1_CHALLENGE_PORT in
# app-1/.env) and restricts it to THIS machine with the DOCKER-USER guard
# (scripts/docker-port-guard.sh — ufw/INPUT rules do NOT cover published
# ports). Candidates always use http://<GATEWAY_IP>/challenge/ ; they must
# never be given an App machine address.
#
# LAN deployment (set the App-1 machine's LAN IP):
#   APP1_CHALLENGE_URL=http://<APP1_LAN_IP>:8080
# Same-machine testing:
#   APP1_CHALLENGE_URL=http://host.docker.internal:8080
#
# NEVER point this at this machine's own :8080 — that is the Traefik
# dashboard port, not the challenge.
APP1_CHALLENGE_URL=http://host.docker.internal:8080

# App-2's challenge server. Leave EMPTY until the App-2 machine exists.
APP2_CHALLENGE_URL=

# ── LAN configuration: Compiler pool (Compiler-1 / Compiler-2 / Compiler-3) ─
# Judge0 execution nodes. /api/execute distributes submissions round-robin
# across the ones set here and fails over when one is unreachable (see
# gateway-api/app/judge0_pool.py). Each is the compiler machine's LAN address
# on the Judge0 API port (JUDGE0_PORT there, default 2358).
#
# Port 2358 on a compiler machine must be firewalled to this machine and the
# App machines:
#   sudo ./scripts/docker-port-guard.sh --ports 2358 \
#        --gateway-ip <GATEWAY_LAN_IP> \
#        --gateway-ip <APP1_LAN_IP> --gateway-ip <APP2_LAN_IP>
#
# Leave all three EMPTY to keep using JUDGE0_URL alone (single-node).
COMPILER_1_URL=
COMPILER_2_URL=
COMPILER_3_URL=

# Legacy single-node compiler address, used only when no COMPILER_n_URL is set.
# Keep the default when a Judge0/compiler stack runs on THIS machine; otherwise
# point it at that node's LAN address.
JUDGE0_URL=http://judge0-server:2358
JUDGE0_TIMEOUT=60.0

# ── Service configuration ───────────────────────────────────────────────────

# Environment tag shown in /api/info
APP_ENV=development

# Version tag
APP_VERSION=0.3.0

# Seconds of inactivity before a session is marked inactive
SESSION_TIMEOUT_SECONDS=300

# How often the stale-checker background thread wakes up (seconds)
STALE_CHECK_INTERVAL_SECONDS=60

# Legacy Compiler-1 runner (only used when EXECUTION_BACKEND=compiler1)
COMPILER_URL=http://compiler-1:8000
COMPILER_TIMEOUT=60.0

# Execution backend: judge0 (Compiler-1/2/3) or compiler1 (legacy runner)
EXECUTION_BACKEND=judge0

# ── Frontend (React SPA) ────────────────────────────────────────────────────
# Supabase credentials for the frontend build (VITE_* prefix for Vite).
# These are the PUBLIC anon key, NOT the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Secret configuration ────────────────────────────────────────────────────
# Shared API token for the compiler nodes. MUST equal AUTHN_TOKEN in
# gateway/judge0/judge0.conf on EVERY compiler machine, and the same value the
# App machines use.
JUDGE0_AUTH_TOKEN=your-judge0-auth-token
JUDGE0_AUTH_HEADER=X-Judge0-Token
