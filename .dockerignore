# Docker build context exclusions (project root)
# Used by gateway/app-1/Dockerfile

# Git
.git/
.gitignore

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/
**/.venv/

# Application build artifacts (the Dockerfile builds these inside the image).
# Excluding them keeps the build context ~small instead of shipping the local
# node_modules/.venv/dist trees into every docker build.
dsc-recruit/apps/frontend/node_modules/
dsc-recruit/apps/frontend/dist/
dsc-recruit/apps/backend/.venv/
dsc-recruit/apps/backend/**/__pycache__/
dsc-recruit/.venv/

# Environment files (secrets) — never copy these into a build context
**/.env
**/.env.local
**/.env.production

# Deployment-side secrets and stacks that are not needed in App 1 image
gateway/judge0/
gateway/monitoring/
load-tests/

# IDE
.vscode/
.idea/

# Gateway infrastructure (not needed in App 1 image)
gateway/gateway-api/
gateway/compiler-1/
gateway/compiler_client/
gateway/traefik/
gateway/test-backend/
gateway/app-1/
gateway/tests/
gateway/.venv-integration/
gateway/.pytest_cache/

# Freebuff platform metadata
.freebuff/

# Documentation
*.md
