[TEMPLATE]
# ══════════════════════════════════════════════════════════════════════════════
# Deployment test configuration
#
# Copy this file to deployment-tests/.env and fill in your machines' LAN IPs.
# Everything is overridable on the command line too:
#   APP1_IP=192.168.1.23 ./deployment-tests/system2-app1-test.sh
#
# DO NOT commit .env (it describes your network). Any system left blank is
# SKIPPED by the tests instead of failing, so the suite stays usable while the
# build-out is in progress.
#
# Find each machine's LAN IP ON THAT MACHINE:
#   Linux:    hostname -I | awk '{print $1}'      or   ip -4 addr
#   Windows:  ipconfig     (IPv4 Address of the active adapter)
# Use the address of the interface that is on the SAME network as the other
# machines — not a VPN/tailscale (100.x) or Docker (172.x) address.
# ══════════════════════════════════════════════════════════════════════════════

# ── The six machines ─────────────────────────────────────────────────────────
# SYSTEM 1 — Gateway (Traefik + frontend + gateway-api)
GATEWAY_IP=

# SYSTEM 2 — App-1 (FastAPI backend + challenge-1)
APP1_IP=

# SYSTEM 4 — App-2 (FastAPI backend + challenge-2). Leave blank until deployed.
APP2_IP=

# SYSTEM 3 — Compiler-1 (Judge0)
COMPILER1_IP=

# SYSTEM 5 — Compiler-2 (Judge0). Leave blank until deployed.
COMPILER2_IP=

# SYSTEM 6 — Compiler-3 (Judge0). Leave blank until deployed.
COMPILER3_IP=

# ── Ports (only change these if you changed them in the .env files) ──────────
# Gateway front door and dashboard
GATEWAY_HTTP_PORT=80
GATEWAY_DASHBOARD_PORT=8080

# App API + Hands-On challenge host ports
APP1_HOST_PORT=8002
APP1_CHALLENGE_PORT=8080
APP2_HOST_PORT=8002
APP2_CHALLENGE_PORT=8080

# Judge0 API host port on every compiler machine
COMPILER_API_PORT=2358
# Only needed when several compiler nodes share ONE host (they then need
# different host ports). On separate machines they all use 2358.
#COMPILER1_API_PORT=2358
#COMPILER2_API_PORT=2359
#COMPILER3_API_PORT=2360

# ── Compiler container-name prefixes (COMPILER_NAME in each machine's .env) ──
COMPILER1_NAME=compiler-1
COMPILER2_NAME=compiler-2
COMPILER3_NAME=compiler-3

# ── Secrets needed for the checks that must authenticate ────────────────────
# Shared Judge0 API token — the same AUTHN_TOKEN as in each compiler machine's
# gateway/judge0/judge0.conf. Leave blank to SKIP the auth checks.
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Judge0-Token

# ── Optional: pin this machine's identity ────────────────────────────────────
# Only needed when auto-detection picks the wrong interface (VPN, Wi-Fi+Ethernet).
#SYSTEM_IP=192.168.1.10
#SYSTEM_IFACE=eth0

# Probe timeouts in seconds.
HTTP_TIMEOUT=8
BLOCK_TIMEOUT=3
